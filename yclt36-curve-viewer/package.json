{
  "name": "yclt36-curve-viewer",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "generate-api": "nswag run",
    "lint": "eslint . --fix",
    "format": "prettier --write src/"
