  "lint-staged": {
    "*.{js,ts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.13.2",
    "dayjs": "^1.11.19",
    "echarts": "^5.4.3",
    "lodash": "^4.17.21",
    "qrcode": "^1.5.4",
    "vue": "^3.3.11",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.23",
    "@types/node": "^25.0.9",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "husky": "^9.1.7",
    "less": "^4.8.1",
    "lint-staged": "^17.3.0",
    "nswag": "^14.0.0",
    "prettier": "^3.9.6",
    "terser": "^5.46.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.66.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^5.0.10",
    "vue-tsc": "^2.0.0"
